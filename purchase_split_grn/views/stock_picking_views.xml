<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_split_grn" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.split.grn</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="split_grn_date" invisible="not split_grn_date"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_split_grn" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.split.grn</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="split_grn_date" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
