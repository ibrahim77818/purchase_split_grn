<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_split_grn" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.split.grn</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="split_grn_active" invisible="1"/>
                <field name="split_grn_by_date_active" invisible="1"/>
                <field name="split_grn_location_active" invisible="1"/>
                <field name="split_grn_warehouse_active" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='date_planned']" position="after">
                <field name="warehouse_id" optional="show"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', parent.company_id)]"
                       column_invisible="not parent.split_grn_warehouse_active or parent.default_location_dest_id_usage not in ('internal', 'transit')"
                       readonly="display_type or parent.state in ('done', 'cancel')"
                       required="not display_type and parent.split_grn_warehouse_active and parent.default_location_dest_id_usage in ('internal', 'transit')"/>
                <field name="location_dest_id" optional="show"
                       groups="stock.group_stock_multi_locations"
                       options="{'no_create': True}"
                       domain="[('usage', 'in', ('internal', 'transit')), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), '|', ('warehouse_id', '=', False), ('warehouse_id', '=', warehouse_id)]"
                       column_invisible="not parent.split_grn_location_active"
                       readonly="display_type or parent.state in ('done', 'cancel')"
                       required="not display_type and parent.split_grn_location_active and parent.default_location_dest_id_usage in ('internal', 'transit')"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='date_planned']" position="after">
                <field name="warehouse_id"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', parent.company_id)]"
                       invisible="display_type or not parent.split_grn_warehouse_active"/>
                <field name="location_dest_id"
                       groups="stock.group_stock_multi_locations"
                       options="{'no_create': True}"
                       domain="[('usage', 'in', ('internal', 'transit')), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), '|', ('warehouse_id', '=', False), ('warehouse_id', '=', warehouse_id)]"
                       invisible="display_type or not parent.split_grn_location_active"/>
            </xpath>
        </field>
    </record>

    <!-- When splitting by date, the line arrival date column is shown by default
         (users of the hidden group get a visible copy instead of the optional one) -->
    <record id="purchase_order_form_split_grn_dates" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.split.grn.dates</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='date_planned']" position="attributes">
                <attribute name="groups">!purchase_split_grn.group_split_grn_by_date</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='date_planned']" position="after">
                <field name="date_planned" optional="show" force_save="1"
                       groups="purchase_split_grn.group_split_grn_by_date"
                       required="not display_type"/>
            </xpath>
        </field>
    </record>
</odoo>
